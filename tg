
// FOOD SAVER SYSTEM

let products = JSON.parse(localStorage.getItem("foodsaver_products")) || [
    {
        id: 1,
        name: "Fresh Apples",
        category: "Fruits",
        quantity: 25,
        unit: "Kg",
        expiration: futureDate(3),
        threshold: 5
    },
    {
        id: 2,
        name: "Fresh Milk",
        category: "Dairy",
        quantity: 10,
        unit: "Liters",
        expiration: futureDate(10),
        threshold: 5
    },
    {
        id: 3,
        name: "Bread",
        category: "Bakery",
        quantity: 15,
        unit: "Pieces",
        expiration: futureDate(-2),
        threshold: 5
    }
];

// DATE FUNCTION
function futureDate(days) {
    const date = new Date();
    date.setDate(date.getDate() + days);

    return date.getFullYear() + "-" +
        String(date.getMonth() + 1).padStart(2, "0") + "-" +
        String(date.getDate()).padStart(2, "0");
}

// SAVE DATA
function saveData() {
    localStorage.setItem(
        "foodsaver_products",
        JSON.stringify(products)
    );
}

// EXPIRATION STATUS
function getDaysRemaining(expiration) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const expDate = new Date(expiration + "T00:00:00");

    return Math.round((expDate - today) / 86400000);
}

function getStatus(product) {
    const days = getDaysRemaining(product.expiration);

    if (days < 0) return "Expired";
    if (days <= 7) return "Expiring Soon";

    return "Available";
}

// STATUS DESIGN
function statusBadge(status) {
    let color = "available";

    if (status === "Expired") color = "expired";
    if (status === "Expiring Soon") color = "expiring";

    return `<span class="status ${color}">${status}</span>`;
}

// SAFE TEXT
function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
    })[char]);
}

// NAVIGATION
function showPage(pageId, element) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById(pageId).classList.add("active");

    document.querySelectorAll(".nav").forEach(link => {
        link.classList.remove("active");
    });

    if (element) {
        element.classList.add("active");
    } else {
        document.querySelectorAll(".nav").forEach(link => {
            if (link.getAttribute("onclick").includes(pageId)) {
                link.classList.add("active");
            }
        });
    }

    const titles = {
        dashboard: "Dashboard",
        inventory: "Food Inventory",
        expiration: "Expiration Tracker",
        notifications: "Notifications"
    };

    document.getElementById("page-title").textContent =
        titles[pageId];

    refreshAll();
}

// OPEN MODAL
function openModal(id = null) {

    const modal = document.getElementById("product-modal");
    const form = document.getElementById("product-form");

    form.reset();

    document.getElementById("edit-id").value = "";
    document.getElementById("threshold").value = 5;
    document.getElementById("modal-title").textContent =
        "Add Food Product";

    if (id !== null) {

        const product = products.find(p => p.id === id);

        if (!product) return;

        document.getElementById("modal-title").textContent =
            "Edit Food Product";

        document.getElementById("edit-id").value = product.id;
        document.getElementById("product-name").value = product.name;
        document.getElementById("category").value = product.category;
        document.getElementById("quantity").value = product.quantity;
        document.getElementById("unit").value = product.unit;
        document.getElementById("expiration-date").value =
            product.expiration;
        document.getElementById("threshold").value =
            product.threshold;
    }

    modal.classList.add("show");
}

// CLOSE MODAL
function closeModal() {
    document.getElementById("product-modal").classList.remove("show");
}

// ADD AND EDIT PRODUCT
document.getElementById("product-form").addEventListener("submit", function(e) {

    e.preventDefault();

    const id = document.getElementById("edit-id").value;

    const name = document.getElementById("product-name").value.trim();
    const category = document.getElementById("category").value;
    const quantity = Number(document.getElementById("quantity").value);
    const unit = document.getElementById("unit").value;
    const expiration = document.getElementById("expiration-date").value;
    const threshold = Number(document.getElementById("threshold").value);

    if (!name || !category || !expiration ||
        !Number.isInteger(quantity) || quantity < 0 ||
        !Number.isInteger(threshold) || threshold < 0) {

        alert("Please enter valid product information.");
        return;
    }

    if (id && !products.some(p => p.id === Number(id))) {
        alert("Product not found.");
        return;
    }

    const product = {
        id: id ? Number(id) : Date.now(),
        name: name,
        category: category,
        quantity: quantity,
        unit: unit,
        expiration: expiration,
        threshold: threshold
    };

    if (id) {

        products = products.map(p =>
            p.id === Number(id) ? product : p
        );

        alert("Product updated successfully!");

    } else {

        products.push(product);

        alert("Product added successfully!");
    }

    saveData();
    closeModal();
    refreshAll();
});

// DELETE PRODUCT
function deleteProduct(id) {

    if (confirm("Are you sure you want to delete this product?")) {

        products = products.filter(p => p.id !== id);

        saveData();
        refreshAll();

        alert("Product deleted successfully!");
    }
}

// INVENTORY TABLE
function renderInventory() {

    const search = document.getElementById("search")
        .value.toLowerCase();

    const filtered = products.filter(p =>
        p.name.toLowerCase().includes(search) ||
        p.category.toLowerCase().includes(search)
    );

    const table = document.getElementById("inventory-table");

    if (filtered.length === 0) {
        table.innerHTML =
            `<tr><td colspan="6">No products found.</td></tr>`;
        return;
    }

    table.innerHTML = filtered.map(p => {

        const status = getStatus(p);

        return `
        <tr>
            <td>${escapeHTML(p.name)}</td>
            <td>${escapeHTML(p.category)}</td>
            <td>${p.quantity} ${escapeHTML(p.unit)}</td>
            <td>${p.expiration}</td>
            <td>${statusBadge(status)}</td>
            <td>
                <button class="action-btn edit-btn"
                    onclick="openModal(${p.id})">
                    <i class="fa-solid fa-pen"></i>
                </button>

                <button class="action-btn delete-btn"
                    onclick="deleteProduct(${p.id})">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </td>
        </tr>`;

    }).join("");
}

// DASHBOARD
function renderDashboard() {

    const expiring = products.filter(p =>
        getStatus(p) === "Expiring Soon"
    );

    const expired = products.filter(p =>
        getStatus(p) === "Expired"
    );

    const stocks = products.reduce((sum, p) =>
        sum + p.quantity, 0
    );

    document.getElementById("total").textContent =
        products.length;

    document.getElementById("expiring").textContent =
        expiring.length;

    document.getElementById("expired").textContent =
        expired.length;

    document.getElementById("stocks").textContent =
        stocks;

    const table = document.getElementById("dashboard-table");

    if (products.length === 0) {
        table.innerHTML =
            `<tr><td colspan="5">No products available.</td></tr>`;
        return;
    }

    table.innerHTML = products.slice(-5).reverse().map(p => `
        <tr>
            <td>${escapeHTML(p.name)}</td>
            <td>${escapeHTML(p.category)}</td>
            <td>${p.quantity} ${escapeHTML(p.unit)}</td>
            <td>${p.expiration}</td>
            <td>${statusBadge(getStatus(p))}</td>
        </tr>
    `).join("");
}

// EXPIRATION TRACKER
function renderExpiration() {

    const table = document.getElementById("expiration-table");

    if (products.length === 0) {
        table.innerHTML =
            `<tr><td colspan="4">No products available.</td></tr>`;
        return;
    }

    table.innerHTML = products.map(p => {

        const days = getDaysRemaining(p.expiration);

        let remaining;

        if (days < 0) {
            remaining = "Expired " + Math.abs(days) + " days ago";
        } else if (days === 0) {
            remaining = "Expires today";
        } else {
            remaining = days + " days";
        }

        return `
        <tr>
            <td>${escapeHTML(p.name)}</td>
            <td>${p.expiration}</td>
            <td>${remaining}</td>
            <td>${statusBadge(getStatus(p))}</td>
        </tr>`;

    }).join("");
}

// NOTIFICATION SYSTEM
function renderNotifications() {

    let alerts = [];

    products.forEach(p => {

        const status = getStatus(p);

        if (status === "Expired") {

            alerts.push({
                type: "danger",
                message: p.name + " has expired."
            });

        } else if (status === "Expiring Soon") {

            alerts.push({
                type: "",
                message: p.name + " is expiring on " + p.expiration + "."
            });
        }

        if (p.quantity <= p.threshold) {

            alerts.push({
                type: "info",
                message: p.name + " has low stock. Remaining: " + p.quantity
            });
        }
    });

    document.getElementById("bell-count").textContent =
        alerts.length;

    document.getElementById("nav-count").textContent =
        alerts.length;

    const list = document.getElementById("notification-list");

    if (alerts.length === 0) {

        list.innerHTML = `
            <div class="notice info">
                <i class="fa-solid fa-circle-check"></i>
                No notifications. Your inventory is looking good!
            </div>
        `;

        return;
    }

    list.innerHTML = alerts.map(a => `
        <div class="notice ${a.type}">
            <i class="fa-solid fa-bell"></i>
            ${escapeHTML(a.message)}
        </div>
    `).join("");
}

// REFRESH ALL MODULES
function refreshAll() {

    renderDashboard();
    renderInventory();
    renderExpiration();
    renderNotifications();
}

// CURRENT DATE
document.getElementById("today").textContent =
    new Date().toLocaleDateString("en-PH", {
        month: "short",
        day: "numeric",
        year: "numeric"
    });

// INITIALIZE
refreshAll();
saveData();
