
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodSaver System</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="sidebar">
    <h2>🥬 FoodSaver</h2>
    <p class="subtitle">Food Management System</p>

    <button onclick="showPage('dashboard')">Dashboard</button>
    <button onclick="showPage('inventory')">Food Inventory</button>
    <button onclick="showPage('tracker')">Expiration Tracker</button>
    <button onclick="showPage('notifications')">Notifications</button>
</div>

<main class="main">

    <header>
        <h1 id="pageTitle">Dashboard</h1>
        <span>FoodSaver Management</span>
    </header>

    <!-- DASHBOARD -->
    <section id="dashboard" class="page">
        <h2>Welcome to FoodSaver!</h2>
        <p>Monitor and manage your food products.</p>

        <div class="stats">
            <div class="card">
                <h3>Total Products</h3>
                <h1 id="totalProducts">0</h1>
            </div>

            <div class="card">
                <h3>Available Stocks</h3>
                <h1 id="availableStocks">0</h1>
            </div>

            <div class="card">
                <h3>Expiring Soon</h3>
                <h1 id="expiringSoon">0</h1>
            </div>

            <div class="card">
                <h3>Expired Products</h3>
                <h1 id="expiredProducts">0</h1>
            </div>
        </div>

        <div class="content-box">
            <h2>Recent Food Products</h2>
            <div id="recentProducts"></div>
        </div>
    </section>

    <!-- FOOD INVENTORY -->
    <section id="inventory" class="page hidden">
        <h2>Food Inventory</h2>

        <form id="productForm">
            <input type="text" id="productName" placeholder="Product Name" required>

            <select id="category" required>
                <option value="">Select Category</option>
                <option>Fruits</option>
                <option>Vegetables</option>
                <option>Dairy</option>
                <option>Meat</option>
                <option>Seafood</option>
                <option>Beverages</option>
                <option>Canned Goods</option>
                <option>Others</option>
            </select>

            <input type="number" id="quantity" placeholder="Quantity" min="0" required>

            <input type="date" id="expiration" required>

            <button type="submit">Add Product</button>
        </form>

        <div class="content-box">
            <h2>Product List</h2>
            <div id="productList"></div>
        </div>
    </section>

    <!-- EXPIRATION TRACKER -->
    <section id="tracker" class="page hidden">
        <h2>Expiration Tracker</h2>
        <p>Monitor the expiration dates of your food products.</p>

        <div class="content-box">
            <div id="expirationList"></div>
        </div>
    </section>

    <!-- NOTIFICATIONS -->
    <section id="notifications" class="page hidden">
        <h2>Notifications</h2>
        <p>Expiration and stock alerts.</p>

        <div class="content-box">
            <div id="notificationList"></div>
        </div>
    </section>

</main>

<script src="script.js"></script>
</body>
</html>
